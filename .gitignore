# Raw source documents are not committed: they are public downloads, and
# scripts/ documents exactly where each one comes from and its checksum.
data/raw/*
!data/raw/README.md

# Month 3 teaching data (small CSVs) is committed so the grader can run the
# guided scripts. Its rasters are not: see the Month 3 block below.
!data/raw/ward_population.csv
!data/raw/health_facilities.csv
!data/raw/lga_facilities/

# Month 3 setup guide: rasters and archives stay on the laptop and are
# described in the data notes instead.
*.tif
*.TIF
*.zip
.vscode/

# Never commit restricted survey microdata or NHW project data
data/restricted/
*.DTA
*.SAV
*.dta
*.sav

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# QGIS / geospatial scratch
*.qgz~
*.gpkg-shm
*.gpkg-wal

# OS
Thumbs.db
.DS_Store

# QGIS: the project file and exported maps are committed; scratch is not
qgis/*.qgz~
qgis/*.qgd

# A QGIS session that was opened from the repo root saves the project back
# there with ./data/... datasources, which breaks when moved. The real
# project is qgis/snt.qgz; any .qgz at the root is a stale copy.
/*.qgz
